PORT=3000
INFERENCE_URL=http://127.0.0.1:8000
INFERENCE_TIMEOUT_MS=3000

# LLM Extraction (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_THINK=true
LLM_TIMEOUT_MS=30000

# Bounded Bedrock smoke runner only; ordinary API/worker startup still uses Ollama.
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=
BEDROCK_PROMPT_VARIANT=evidence-v2
# Set AWS_PROFILE to an existing scoped profile, or use your environment's role.
# AWS_PROFILE=ai-platform-lab-login
# npm run verify:bedrock:single makes ONE LIVE request using these settings.
# Optional deadline; default 30000 milliseconds.
# BEDROCK_TIMEOUT_MS=30000
# Optional operator-reviewed current token prices; leave both unset for unknown cost.
# BEDROCK_INPUT_USD_PER_MILLION=
# BEDROCK_OUTPUT_USD_PER_MILLION=

# Local durable background jobs (enable explicitly)
JOBS_ENABLED=false
JOB_DB_PATH=data/extraction-jobs.sqlite
